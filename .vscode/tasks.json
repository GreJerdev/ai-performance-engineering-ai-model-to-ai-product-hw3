{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "langgraph: dev (debug)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/langgraph.exe",
      "args": ["dev", "--debug-port", "5678", "--wait-for-client"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "langgraph",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Waiting for debugger|wait-for-client|5678)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
